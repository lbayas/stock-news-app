# Database
DATABASE_URL=postgresql://menton:menton@db:5432/menton

# External APIs (Required)
MASSIVE_API_KEY=           # Polygon.io - prices, company data, news
OPENAI_API_KEY=            # OpenAI - correlation scoring, chat

# Configuration
MAJOR_MOVE_THRESHOLD=2.0   # Minimum % change to flag as major movement
DEFAULT_LOOKBACK_DAYS=365  # How far back to fetch price history
OPENAI_MAX_WORKERS=5       # Concurrent API calls for scoring (default: 5)
